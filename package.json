{
  "name": "@jeyabbalas/data-table",
  "version": "0.1.0",
  "description": "A client-side JavaScript library for interactive, explorable data tables using DuckDB WASM",
  "type": "module",
  "module": "./dist/data-table.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/data-table.js"
    },
    "./styles": "./dist/data-table.css",
    "./styles.css": "./dist/data-table.css"
  },
  "files": [
    "dist"
  ],
  "style": "./dist/data-table.css",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build": "tsc && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "data-table",
    "duckdb",
    "analytics",
    "visualization",
    "interactive"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@latest"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev42.0",
    "@lezer/highlight": "^1.2.3"
  }
}
